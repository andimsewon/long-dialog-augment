# Copy this file to .env and fill in your values.
# python-dotenv will load it automatically if you call load_dotenv() at startup,
# or you can export these manually before running the pipeline.

# vLLM server endpoint (required if not using localhost)
LLAMA_SERVER_URL=http://localhost:8001/v1/completions

# Model ID served by vLLM (override if you deploy a different checkpoint)
LLAMA_MODEL_ID=ibnzterrell/Meta-Llama-3.3-70B-Instruct-AWQ-INT4
